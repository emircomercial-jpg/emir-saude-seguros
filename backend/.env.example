# O backend (NestJS) lê o ficheiro ".env" a partir da pasta onde é executado
# (backend/), tal como o Prisma CLI. Copie este ficheiro para "backend/.env"
# e preencha os valores — mantenha-o sincronizado com o ".env" da raiz do
# projecto (usado pelo Docker Compose), ou crie um link simbólico:
#
#   cd backend && ln -s ../.env .env

NODE_ENV=development
BACKEND_PORT=3000

DATABASE_URL="postgresql://emir:change_me_postgres_password@localhost:5432/emir_saude_seguros?schema=public"

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECRET=change_me_cookie_secret
CORS_ORIGIN=http://localhost:5173

APP_NAME="EMIR SAÚDE SEGUROS"
APP_URL=http://localhost:5173
API_URL=http://localhost:3000/api

TIMEZONE=Africa/Luanda
DEFAULT_LANGUAGE=pt
DEFAULT_CURRENCY=AOA

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Rate limiting da API (secção 24) — janela em segundos e nº máximo de pedidos
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100

SWAGGER_ENABLED=true

# Necessárias apenas para o seed (secção 6)
ADMIN_NAME="Administrador Geral"
ADMIN_EMAIL=admin@emirsaude.co.ao
ADMIN_PASSWORD=change_me_admin_password
ORGANIZATION_NIF=

# E-mail (opcional). Se SMTP_HOST não estiver definido, os e-mails são
# apenas registados no terminal do backend (modo de desenvolvimento) —
# nenhum envio real é tentado, e a aplicação continua a funcionar
# normalmente sem estas variáveis.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="EMIR SAÚDE SEGUROS <no-reply@emirsaude.co.ao>"
APP_NAME="EMIR SAÚDE SEGUROS"
APP_URL=http://localhost:5173

# WhatsApp (opcional). Sem estas variáveis, as notificações por WhatsApp
# ficam apenas registadas no terminal do backend (modo de desenvolvimento),
# com o link wa.me equivalente para testar manualmente. Requer uma conta
# Meta for Developers com WhatsApp Business API activo — ver
# backend/src/whatsapp/whatsapp-cloud-api.service.ts para os detalhes.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
