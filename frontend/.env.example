VITE_API_URL=http://localhost:3000/api
VITE_APP_NAME="EMIR SAÚDE SEGUROS"

# Em produção (Cloudflare Pages / Vercel), definir VITE_API_URL para o
# URL do backend no Render, ex:
# VITE_API_URL=https://emir-saude-backend.onrender.com/api
# Esta variável é lida em BUILD TIME pelo Vite — tem de estar definida nas
# variáveis de ambiente do painel de build (Cloudflare Pages / Vercel),
# nunca só num .env local que não é enviado para o Git.
