# =========================================================
# EMIR SAÚDE SEGUROS — Variáveis de Ambiente (exemplo)
# Copiar para ".env" e preencher com valores reais.
# NUNCA colocar segredos reais neste ficheiro (.env.example).
# =========================================================

# Ambiente
NODE_ENV=development

# Portas
FRONTEND_PORT=5173
BACKEND_PORT=3000

# Base de dados PostgreSQL
POSTGRES_USER=emir
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=emir_saude_seguros
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL="postgresql://emir:change_me_postgres_password@localhost:5432/emir_saude_seguros?schema=public"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECRET=change_me_cookie_secret

# CORS
CORS_ORIGIN=http://localhost:5173

# Administrador inicial (usado apenas pelo seed — nunca fixo no código)
ADMIN_NAME="Administrador Geral"
ADMIN_EMAIL=admin@emirsaude.co.ao
ADMIN_PASSWORD=change_me_admin_password

# Organização (opcional — usado pelo seed)
ORGANIZATION_NIF=

# Aplicação
APP_NAME="EMIR SAÚDE SEGUROS"
APP_URL=http://localhost:5173
# Usado pelo docker-compose.yml para definir VITE_API_URL como argumento de
# BUILD da imagem do frontend (nunca como variável de ambiente do
# contentor — o Vite só a lê durante "npm run build", nunca depois). Ao
# mudar este valor, é preciso reconstruir a imagem do frontend
# (`docker compose up -d --build frontend`), não basta reiniciar o contentor.
API_URL=http://localhost:3000/api

# Localização
TIMEZONE=Africa/Luanda
DEFAULT_LANGUAGE=pt
DEFAULT_CURRENCY=AOA

# Segurança de autenticação
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Rate limiting da API (secção 24) — janela em segundos e nº máximo de pedidos
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100

# Documentação da API
SWAGGER_ENABLED=true

# E-mail (opcional) — sem SMTP_HOST, os e-mails ficam apenas registados no
# terminal do backend (modo de desenvolvimento).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="EMIR SAÚDE SEGUROS <no-reply@emirsaude.co.ao>"
APP_NAME="EMIR SAÚDE SEGUROS"
APP_URL=http://localhost:5173

# WhatsApp (opcional) — sem estas variáveis, as notificações ficam apenas
# registadas no terminal do backend (modo de desenvolvimento).
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
